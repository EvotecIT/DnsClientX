<Project>
  <!-- .NET Framework does not resolve NuGet runtime assets through a .deps.json file. -->
  <PropertyGroup>
    <DnsClientXSodiumPackagePath Condition="'$(Pkglibsodium)' != ''">$(Pkglibsodium)</DnsClientXSodiumPackagePath>
    <DnsClientXSodiumPackagePath Condition="'$(DnsClientXSodiumPackagePath)' == ''">$(NuGetPackageRoot)libsodium/1.0.22</DnsClientXSodiumPackagePath>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <None Include="$(DnsClientXSodiumPackagePath)/runtimes/win-x86/native/libsodium.dll" Link="runtimes/win-x86/native/libsodium.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(DnsClientXSodiumPackagePath)/runtimes/win-x64/native/libsodium.dll" Link="runtimes/win-x64/native/libsodium.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(DnsClientXSodiumPackagePath)/runtimes/win-arm64/native/libsodium.dll" Link="runtimes/win-arm64/native/libsodium.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
