<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>DnsRecords</Name>
      <ViewSelectedBy><TypeName>DnsClientX.DnsAnswerMinimal</TypeName><TypeName>DnsClientX.DnsAnswer</TypeName></ViewSelectedBy>
      <TableControl><TableHeaders>
        <TableColumnHeader><Label>Name</Label></TableColumnHeader><TableColumnHeader><Label>Type</Label><Width>10</Width></TableColumnHeader>
        <TableColumnHeader><Label>TTL</Label><Width>10</Width><Alignment>Right</Alignment></TableColumnHeader><TableColumnHeader><Label>Data</Label></TableColumnHeader>
      </TableHeaders><TableRowEntries><TableRowEntry><TableColumnItems>
        <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Type</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>TTL</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Data</PropertyName></TableColumnItem>
      </TableColumnItems></TableRowEntry></TableRowEntries></TableControl>
    </View>
    <View>
      <Name>DnsServices</Name><ViewSelectedBy><TypeName>DnsClientX.DnsService</TypeName></ViewSelectedBy>
      <TableControl><TableHeaders>
        <TableColumnHeader><Label>Service</Label></TableColumnHeader><TableColumnHeader><Label>Target</Label></TableColumnHeader>
        <TableColumnHeader><Label>Port</Label><Width>7</Width><Alignment>Right</Alignment></TableColumnHeader>
        <TableColumnHeader><Label>Priority</Label><Width>9</Width><Alignment>Right</Alignment></TableColumnHeader>
        <TableColumnHeader><Label>Weight</Label><Width>8</Width><Alignment>Right</Alignment></TableColumnHeader>
      </TableHeaders><TableRowEntries><TableRowEntry><TableColumnItems>
        <TableColumnItem><PropertyName>ServiceName</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Target</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>Port</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Priority</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Weight</PropertyName></TableColumnItem>
      </TableColumnItems></TableRowEntry></TableRowEntries></TableControl>
    </View>
    <View>
      <Name>DnsSrvTargets</Name><ViewSelectedBy><TypeName>DnsClientX.DnsSrvRecord</TypeName></ViewSelectedBy>
      <TableControl><TableHeaders>
        <TableColumnHeader><Label>Target</Label></TableColumnHeader><TableColumnHeader><Label>Port</Label><Width>7</Width></TableColumnHeader>
        <TableColumnHeader><Label>Priority</Label><Width>9</Width></TableColumnHeader><TableColumnHeader><Label>Weight</Label><Width>8</Width></TableColumnHeader><TableColumnHeader><Label>Addresses</Label></TableColumnHeader>
      </TableHeaders><TableRowEntries><TableRowEntry><TableColumnItems>
        <TableColumnItem><PropertyName>Target</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Port</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>Priority</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Weight</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Addresses</PropertyName></TableColumnItem>
      </TableColumnItems></TableRowEntry></TableRowEntries></TableControl>
    </View>
    <View>
      <Name>DnsProbeResults</Name><ViewSelectedBy><TypeName>DnsClientX.PowerShell.DnsProbeResult</TypeName></ViewSelectedBy>
      <TableControl><TableHeaders>
        <TableColumnHeader><Label>Target</Label></TableColumnHeader><TableColumnHeader><Label>Transport</Label><Width>18</Width></TableColumnHeader>
        <TableColumnHeader><Label>Status</Label><Width>14</Width></TableColumnHeader><TableColumnHeader><Label>ms</Label><Width>9</Width></TableColumnHeader>
        <TableColumnHeader><Label>Answers</Label><Width>9</Width></TableColumnHeader><TableColumnHeader><Label>Recommended</Label><Width>13</Width></TableColumnHeader>
      </TableHeaders><TableRowEntries><TableRowEntry><TableColumnItems>
        <TableColumnItem><PropertyName>Target</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Transport</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Status</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>ElapsedMs</PropertyName><FormatString>{0:N2}</FormatString></TableColumnItem><TableColumnItem><PropertyName>AnswerCount</PropertyName></TableColumnItem><TableColumnItem><PropertyName>IsRecommended</PropertyName></TableColumnItem>
      </TableColumnItems></TableRowEntry></TableRowEntries></TableControl>
    </View>
    <View>
      <Name>DnsBenchmarkResults</Name><ViewSelectedBy><TypeName>DnsClientX.PowerShell.DnsBenchmarkResult</TypeName></ViewSelectedBy>
      <TableControl><TableHeaders>
        <TableColumnHeader><Label>Target</Label></TableColumnHeader><TableColumnHeader><Label>Transport</Label><Width>18</Width></TableColumnHeader>
        <TableColumnHeader><Label>Success %</Label><Width>10</Width></TableColumnHeader><TableColumnHeader><Label>Average ms</Label><Width>12</Width></TableColumnHeader>
        <TableColumnHeader><Label>Queries</Label><Width>9</Width></TableColumnHeader><TableColumnHeader><Label>Recommended</Label><Width>13</Width></TableColumnHeader>
      </TableHeaders><TableRowEntries><TableRowEntry><TableColumnItems>
        <TableColumnItem><PropertyName>Target</PropertyName></TableColumnItem><TableColumnItem><PropertyName>Transport</PropertyName></TableColumnItem><TableColumnItem><PropertyName>SuccessPercent</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>AverageMs</PropertyName><FormatString>{0:N2}</FormatString></TableColumnItem><TableColumnItem><PropertyName>TotalQueries</PropertyName></TableColumnItem><TableColumnItem><PropertyName>IsRecommended</PropertyName></TableColumnItem>
      </TableColumnItems></TableRowEntry></TableRowEntries></TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
